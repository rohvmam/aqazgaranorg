# Copy to C:\apps\aqazgaran\.env and fill in. This file is a template only -
# .env is gitignored and never leaves the server.

# --- Database -------------------------------------------------------------
# 02-database.ps1 prints this line ready to paste.
DATABASE_URL="postgresql://aqazgaran:REPLACE_ME@localhost:5432/aqazgaran?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate a NEW one for this server (do not reuse Render's):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_ME"
# Required: Auth.js sits behind the Caddy reverse proxy.
AUTH_TRUST_HOST=true

# --- Public URL -----------------------------------------------------------
# Used by password-reset emails, sitemap.xml and page metadata.
# Must be the real https:// address, or reset links point at localhost.
SITE_URL="https://REPLACE_ME.com"

# --- Email (OTP codes and password resets) --------------------------------
# Gmail needs a 16-character App Password, not the account password:
#   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
#
# IMPORTANT: SMTP_HOST and SMTP_USER together switch real sending on. Set
# SMTP_USER and SMTP_PASSWORD in the same edit - a user without a password
# makes every send fail authentication AND stops the console fallback, which
# leaves nobody able to receive a login code.
#
# Leave SMTP_USER and SMTP_PASSWORD empty to keep codes printed to
# logs\app.out.log instead (useful before the App Password exists).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="you@gmail.com"
